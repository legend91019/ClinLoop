# ClinLoop environment template.
# Copy to .env and fill in local values. NEVER commit the real .env.

# --- Persistence ---
DATABASE_URL=postgresql+psycopg://clinloop:clinloop@localhost:5432/clinloop
REDIS_URL=redis://localhost:6379/0
EVENT_BUS=noop

# --- Ports ---
API_PORT=8000
WEB_PORT=5173

# --- Agent ---
OPENAI_API_KEY=
AGENT_PROVIDER=mock
AGENT_STEP_BUDGET=8
AGENT_TIMEOUT_SECONDS=30
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
