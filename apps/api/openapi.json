      "get": {
        "tags": [
          "findings"
        ],
        "summary": "Get Evidence Source",
        "description": "Resolve explicit provenance.event_id first, validating patient, encounter and source type. Without an explicit pointer, return only an unambiguous source in the same scope.",
        "operationId": "get_evidence_source_api_v1_evidence__evidence_id__source_get",
        "parameters": [
          {
            "name": "evidence_id",
            "in": "path",
            "required": true,
