      "get": {
        "tags": [
          "findings"
        ],
        "summary": "Workflow gap detail",
        "description": "Return a finding.\n\n``supporting_evidence`` and ``searched_sources`` are always included:\nthe console must be able to show *what was searched*, so that a gap in\ncoverage is never presented as proof of absence.",
        "operationId": "get_finding_api_v1_findings__finding_id__get",
        "parameters": [
          {
            "name": "finding_id",
            "in": "path",
            "required": true,
