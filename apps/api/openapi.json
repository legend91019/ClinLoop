  "components": {
    "schemas": {
      "ActorRef": {
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "title": "Actor Id"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "title": "Role"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "actor_id",
          "role"
        ],
        "title": "ActorRef",
        "description": "Who or what produced a record."
      },
      "ClinicalEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "title": "Event Id"
          },
          "patient_id": {
            "type": "string",
            "minLength": 1,
            "title": "Patient Id"
          },
          "encounter_id": {
            "type": "string",
            "minLength": 1,
            "title": "Encounter Id"
          },
          "event_type": {
            "$ref": "#/components/schemas/EventType"
          },
          "event_time": {
            "type": "string",
            "format": "date-time",
            "title": "Event Time"
          },
          "source_time": {
            "type": "string",
            "format": "date-time",
            "title": "Source Time"
          },
          "payload_ref": {
            "type": "string",
            "minLength": 1,
            "title": "Payload Ref"
          },
          "actor": {
            "$ref": "#/components/schemas/ActorRef"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "ingested_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ingested At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "patient_id",
          "encounter_id",
          "event_type",
          "event_time",
          "source_time",
          "payload_ref",
          "actor"
        ],
        "title": "ClinicalEvent",
        "description": "An inbound clinical event on the event stream.\n\n``source_time`` is when the source system recorded it; ``event_time``\nis when it occurred in the patient's timeline. They may differ\n(transcription lag) and are kept separate on purpose."
      },
      "EventAcceptedResponse": {
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "title": "Event Id"
          },
          "accepted": {
            "type": "boolean",
            "title": "Accepted",
