{
  "openapi": "3.1.0",
  "info": {
    "title": "ClinLoop API",
    "description": "Event-driven clinical workflow continuity API. Synthetic data only — engineered validation, not evidence of clinical effectiveness. The API proposes; it never diagnoses, recommends treatment, or writes to a medical record.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "description": "Return ``{\"status\": \"ok\"}`` when the process is serving.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness probe",
        "description": "Return ``ok`` only when the database answers a trivial query.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Readyz Readyz Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Ingest a clinical event",
        "description": "Persist a clinical event and publish it for the workflow worker.\n\nThe event is stored before it is published so a worker crash cannot\nlose it; a re-delivery of the same ``event_id`` is rejected with 409\nrather than silently double-counted.",
        "operationId": "ingest_event_api_v1_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClinicalEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventAcceptedResponse"
                }
              }
            }
          },
          "409": {
            "description": "An event with this event_id was already ingested"
          },
          "422": {
            "description": "The event payload violates the contract"
          }
        }
      }
    },
    "/api/v1/patients/{patient_id}/timeline": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Patient event timeline",
        "description": "Return the patient's events from the last ``hours``, oldest first.\n\nAn unknown patient is not an error — it is an empty timeline, which\nthe console renders as an empty state.",
        "operationId": "patient_timeline_api_v1_patients__patient_id__timeline_get",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Patient Id"
            }
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 720,
              "minimum": 1,
              "default": 24,
              "title": "Hours"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimelineResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/patients/{patient_id}/loops": {
      "get": {
        "tags": [
          "loops"
        ],
        "summary": "List a patient's open loops",
        "description": "List loops for a patient. Pass ``active_only=true`` to hide closed work.",
        "operationId": "list_loops_api_v1_patients__patient_id__loops_get",
        "parameters": [
          {
            "name": "patient_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Patient Id"
            }
          },
          {
            "name": "active_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Return only loops that are still open",
              "default": false,
              "title": "Active Only"
            },
            "description": "Return only loops that are still open"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LoopSummary"
                  },
                  "title": "Response List Loops Api V1 Patients  Patient Id  Loops Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
